# Copia este archivo como .env (nunca subas .env al repositorio).
# Las variables VITE_ se incrustan en el código al compilar: son públicas, no pongas secretos.

# URL base de la API. Si falta, se usa la de producción (src/lib/api.ts).
VITE_API_URL=https://odontosystem-production.up.railway.app

# Client ID OAuth de tipo Web (el mismo que GOOGLE_CLIENT_ID del backend).
# Sin él, el botón «Continuar con Google» muestra un aviso y se entra con correo y contraseña.
VITE_GOOGLE_CLIENT_ID=
